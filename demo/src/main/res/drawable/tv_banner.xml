<?xml version="1.0" encoding="utf-8"?>
<!-- The TV launcher's tile, 320×180dp: the demo's name on the ad badge's yellow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF141218" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:gravity="center" android:width="200dp" android:height="72dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFCC00" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
